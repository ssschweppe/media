<% content_for :title, @category.name %>

<div class="admin-title">
  <h1>Категория «<%= @category.name %>»</h1>
  <div class="admin-actions">
    <%= link_to "Изменить", edit_admin_category_path(@category), class: "button" %>
    <%= button_to "Удалить", admin_category_path(@category), method: :delete, class: "link-button link-danger",
                  form: { data: { turbo_confirm: "Удалить категорию «#{@category.name}»?" } } %>
  </div>
</div>

<p>
  Slug: <code><%= @category.slug %></code> · Порядок: <%= @category.position %>
</p>

<% if @category.description.present? %>
  <p><%= @category.description %></p>
<% end %>

<h2>Посты в категории</h2>
<%= render "admin/posts_table", posts: @posts %>

<p><%= link_to "← Все категории", admin_categories_path %></p>
