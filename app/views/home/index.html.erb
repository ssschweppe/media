<%# Заглушка сайта (splash). Макеты: splash/desktop и splash/mobile в Figma %>
<div class="splash">
  <header class="splash-header l-container">
    <p class="t-label">■ Скоро запуск</p>
    <%= link_to about_path, class: "nav-link" do %>
      О проекте <%= render "landing/arrow" %>
    <% end %>
  </header>

  <main class="splash-main l-container">
    <div class="splash-content">
      <div class="splash-intro">
        <%= render "landing/logo", tag_name: :h1, modifier: "logo--splash" %>
        <p class="splash-subtitle">
          Медиа<span class="only-d">-сервис</span> о том, из чего складывается стоимость разработки сайтов и приложений
        </p>
      </div>

      <section class="subscribe-card" aria-label="Подписка на рассылку">
        <p class="t-label">■ Узнать о запуске первыми</p>
        <%= render "subscribers/form", subscriber: Subscriber.new, placement: "splash" %>
      </section>
    </div>

    <%# Иллюстрация: смета под лупой. На мобильном — обрезанный фрагмент %>
    <div class="splash-art">
      <picture>
        <source media="(min-width: 1024px)" srcset="<%= asset_path("xray.svg") %>">
        <%= image_tag "xray-mobile.svg", alt: "", width: 345, height: 330 %>
      </picture>
    </div>
  </main>
</div>
