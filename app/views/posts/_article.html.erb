<%# Пост целиком. Используется на сайте (posts/show) и в админке (admin/posts/show) %>
<article class="article">
  <header class="article-header">
    <p class="article-meta">
      <%= post.rubric.name %>
      <% if post.category %>
        · <%= post.category.name %>
      <% end %>
      <% if post.published_at %>
        · <%= time_tag post.published_at, l(post.published_at, format: :date) %>
      <% end %>
    </p>

    <h1><%= post.title %></h1>

    <% if post.lead.present? %>
      <p class="article-lead"><%= post.lead %></p>
    <% end %>
  </header>

  <% if post.cover.present? %>
    <%= image_tag post.cover.url, alt: "", class: "article-cover" %>
  <% end %>

  <div class="article-body">
    <%= markdown(post.body) %>
  </div>
</article>
