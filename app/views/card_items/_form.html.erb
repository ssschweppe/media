<%= form_with(model: card_item) do |form| %>
  <% if card_item.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(card_item.errors.count, "error") %> prohibited this card_item from being saved:</h2>

      <ul>
        <% card_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :kind, style: "display: block" %>
    <%= form.select :kind, CardItem.kinds.keys %>
  </div>

  <div>
    <%= form.label :text, style: "display: block" %>
    <%= form.textarea :text %>
  </div>

  <div>
    <%= form.label :position, style: "display: block" %>
    <%= form.number_field :position %>
  </div>

  <div>
    <%= form.label :breakdown_id, style: "display: block" %>
    <%= form.select :breakdown_id, Breakdown.all.collect { |b| [b.title, b.id] }, include_blank: "Выберите разбор" %>
  </div>

  <div>
    <%= form.label :source_id, style: "display: block" %>
    <%= form.select :source_id, Source.all.collect { |s| [s.title, s.id] }, include_blank: "Без источника (гипотеза)" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
