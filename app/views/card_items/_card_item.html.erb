<div id="<%= dom_id card_item %>">
  <div>
    <strong>Kind:</strong>
    <%= card_item.kind %>
  </div>

  <div>
    <strong>Text:</strong>
    <%= card_item.text %>
  </div>

  <div>
    <strong>Position:</strong>
    <%= card_item.position %>
  </div>

  <div>
    <strong>Breakdown:</strong>
    <%= card_item.breakdown_id %>
  </div>

  <div>
    <strong>Source:</strong>
    <%= card_item.source_id %>
  </div>

</div>
