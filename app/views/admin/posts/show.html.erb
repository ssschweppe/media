<% content_for :title, @post.title %>

<div class="admin-title">
  <h1><%= @post.title %></h1>
  <div class="admin-actions">
    <% if @post.published? %>
      <%= link_to "Открыть на сайте", post_path(@post.slug) %>
    <% end %>
    <%= link_to "Изменить", edit_admin_post_path(@post), class: "button" %>
    <%= button_to "Удалить", admin_post_path(@post), method: :delete, class: "link-button link-danger",
                  form: { data: { turbo_confirm: "Удалить пост «#{@post.title}»?" } } %>
  </div>
</div>

<table class="admin-table admin-details">
  <tbody>
    <tr>
      <th>Статус</th>
      <td><%= render "admin/post_status", post: @post %></td>
    </tr>
    <tr>
      <th>Slug</th>
      <td><code><%= @post.slug %></code></td>
    </tr>
    <tr>
      <th>Рубрика</th>
      <td><%= link_to @post.rubric.name, admin_rubric_path(@post.rubric) %></td>
    </tr>
    <tr>
      <th>Категория</th>
      <td><%= @post.category ? link_to(@post.category.name, admin_category_path(@post.category)) : "—" %></td>
    </tr>
    <tr>
      <th>Опубликован</th>
      <td><%= @post.published_at ? l(@post.published_at) : "—" %></td>
    </tr>
    <tr>
      <th>Лид</th>
      <td><%= @post.lead.presence || "—" %></td>
    </tr>
    <tr>
      <th>Обложка</th>
      <td>
        <% if @post.cover.present? %>
          <%= image_tag @post.cover.url, alt: "", class: "admin-cover" %>
        <% else %>
          —
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<h2>Текст</h2>
<div class="admin-body">
  <%= markdown(@post.body) %>
</div>

<p><%= link_to "← Все посты", admin_posts_path %></p>
