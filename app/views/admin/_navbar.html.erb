<header class="admin-header">
  <nav class="admin-nav">
    <%= link_to "Дашборд", admin_root_path, class: ("active" if controller_name == "dashboard") %>
    <%= link_to "Рубрики", admin_rubrics_path, class: ("active" if controller_name == "rubrics") %>
    <%= link_to "Категории", admin_categories_path, class: ("active" if controller_name == "categories") %>
    <%= link_to "Посты", admin_posts_path, class: ("active" if controller_name == "posts") %>
    <%= link_to "Подписчики", admin_subscribers_path, class: ("active" if controller_name == "subscribers") %>
  </nav>

  <div class="admin-user">
    <%= link_to "На сайт", root_path %>
    <span><%= current_user.email %></span>
    <%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "link-button" %>
  </div>
</header>
