<% content_for :title, "Посты" %>

<div class="admin-title">
  <h1>Посты</h1>
  <%= link_to "Новый пост", new_admin_post_path, class: "button" %>
</div>

<%# Фильтр по статусу: ?status=draft и т. д. %>
<nav class="admin-actions">
  <%= link_to_unless params[:status].blank?, "Все", admin_posts_path %>
  <% Post::STATUSES.each do |status, name| %>
    · <%= link_to_unless params[:status] == status, name, admin_posts_path(status: status) %>
  <% end %>
</nav>

<%= render "admin/posts_table", posts: @posts %>
