<% content_for :title, "Категории" %>

<div class="admin-title">
  <h1>Категории</h1>
  <%= link_to "Новая категория", new_admin_category_path, class: "button" %>
</div>

<% if @categories.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Порядок</th>
        <th>Название</th>
        <th>Slug</th>
        <th>Постов</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.position %></td>
          <td><%= link_to category.name, admin_category_path(category) %></td>
          <td><code><%= category.slug %></code></td>
          <td><%= category.posts.count %></td>
          <td class="admin-actions">
            <%= link_to "Изменить", edit_admin_category_path(category) %>
            <%= button_to "Удалить", admin_category_path(category), method: :delete, class: "button-danger",
                          form: { data: { turbo_confirm: "Удалить категорию «#{category.name}»?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Категорий пока нет.</p>
<% end %>
