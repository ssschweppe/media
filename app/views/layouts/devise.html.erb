<%# Layout страниц Devise (вход, регистрация). Rails находит его сам по имени DeviseController.
    Оформление как в админке: body.admin и стили из admin.css %>
<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Вход" %> · терракот</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <header class="admin-header">
      <nav class="admin-nav">
        <%= link_to "терракот", root_path, class: "admin-logo" %>
      </nav>

      <% if user_signed_in? %>
        <div class="admin-user">
          <% if current_user.admin? %>
            <%= link_to "Админка", admin_root_path %>
          <% end %>
          <span><%= current_user.email %></span>
          <%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "link-button" %>
        </div>
      <% end %>
    </header>

    <main class="admin-main">
      <%= render "flash" %>
      <%= yield %>
    </main>
  </body>
</html>
