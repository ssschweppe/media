<% content_for :title, "Регистрация" %>

<h1>Регистрация</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "admin-form auth-form" }) do |f| %>
  <%= render "admin/form_errors", record: resource %>

  <div class="form-field">
    <%= f.label :email %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="form-field">
    <%= f.label :password %>
    <%= f.password_field :password, autocomplete: "new-password" %>
    <% if @minimum_password_length %>
      <p class="hint">Минимум <%= @minimum_password_length %> символов</p>
    <% end %>
  </div>

  <div class="form-field">
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <%= f.submit "Зарегистрироваться" %>
<% end %>

<%= render "devise/shared/links" %>
