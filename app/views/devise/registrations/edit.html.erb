<% content_for :title, "Настройки аккаунта" %>

<h1>Настройки аккаунта</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "admin-form auth-form" }) do |f| %>
  <%= render "admin/form_errors", record: resource %>

  <div class="form-field">
    <%= f.label :email %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="form-field">
    <%= f.label :password, "Новый пароль" %>
    <%= f.password_field :password, autocomplete: "new-password" %>
    <p class="hint">
      Оставьте пустым, если не хотите менять<% if @minimum_password_length %>. Минимум <%= @minimum_password_length %> символов<% end %>
    </p>
  </div>

  <div class="form-field">
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="form-field">
    <%= f.label :current_password %>
    <%= f.password_field :current_password, autocomplete: "current-password" %>
    <p class="hint">Нужен, чтобы сохранить изменения</p>
  </div>

  <%= f.submit "Сохранить" %>
<% end %>

<h2>Удаление аккаунта</h2>

<%= button_to "Удалить аккаунт", registration_path(resource_name), method: :delete,
      class: "link-button link-danger", data: { turbo_confirm: "Удалить аккаунт? Это нельзя отменить" } %>
