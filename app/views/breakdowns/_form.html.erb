<%= form_with(model: breakdown) do |form| %>
  <% if breakdown.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(breakdown.errors.count, "error") %> prohibited this breakdown from being saved:</h2>

      <ul>
        <% breakdown.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :lead, style: "display: block" %>
    <%= form.textarea :lead %>
  </div>

  <div>
    <%= form.label :body, style: "display: block" %>
    <%= form.textarea :body %>
  </div>

  <div>
    <%= form.label :demo_key, style: "display: block" %>
    <%= form.text_field :demo_key %>
  </div>

  <div>
    <%= form.label :published_at, style: "display: block" %>
    <%= form.datetime_field :published_at %>
  </div>

  <div>
    <%= form.label :pattern_id, style: "display: block" %>
    <%= form.text_field :pattern_id %>
  </div>

  <div>
    <%= form.label :example_id, style: "display: block" %>
    <%= form.text_field :example_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
