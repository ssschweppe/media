<% content_for :title, "Подписчики" %>

<h1>Подписчики</h1>

<% if @subscribers.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Почта</th>
        <th>Подписался</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @subscribers.each do |subscriber| %>
        <tr>
          <td><%= subscriber.email %></td>
          <td><%= l(subscriber.created_at) %></td>
          <td class="admin-actions">
            <%= button_to "Удалить", admin_subscriber_path(subscriber), method: :delete, class: "link-button link-danger",
                          form: { data: { turbo_confirm: "Удалить #{subscriber.email} из рассылки?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Подписчиков пока нет.</p>
<% end %>
